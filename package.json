{
  "name": "sonalpi2",
  "version": "0.2.0",
  "description": "SonalPi2 — set minimum SonalPi1 : import, locuteurs, thèmes, données (asynchrone, ProseMirror sans Yjs)",
  "main": "./out/main/index.js",
  "author": {
    "name": "Max Beligné",
    "email": "sonalteam@gmail.com"
  },
  "homepage": "https://github.com/PUD-GA/SonalPiTestV2",
  "scripts": {
    "dev": "electron-vite dev",
    "postinstall": "node node_modules/electron/install.js",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "pack": "npm run build && electron-builder --publish never",
    "pack:dir": "npm run build && electron-builder --dir",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:charge": "node scripts/test-charge.mjs",
    "diagnostic:e2e": "npm run build && playwright test --config=playwright.diagnostic.config.ts",
    "test:multiuser": "npm run build && playwright test e2e/multi-utilisateur.e2e.ts --workers=1",
    "test:gitlab": "vitest run test/gitlab",
    "test:gitlab:e2e": "npm run build && playwright test e2e/gitlab-consultation.e2e.ts --project=local --workers=1",
    "test:migration:gitlab:e2e": "npm run build && playwright test e2e/migration-gitlab.e2e.ts --project=local --workers=1",
    "test:gitlab:e2e:packaged": "npm run pack:dir && GITLAB_E2E_PACKAGED=1 playwright test e2e/gitlab-consultation.e2e.ts --project=local --workers=1",
    "test:gitlab:long": "GITLAB_BAIL_CAMPAIGN=1 vitest run test/gitlab/contrat-gitlab.test.ts -t 'campagne longue' --silent=false",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "nc:up": "docker compose -f docker/compose.yml up -d",
    "nc:provision": "bash docker/provisionner.sh",
    "nc:down": "docker compose -f docker/compose.yml down",
    "nc:logs": "docker compose -f docker/compose.yml logs -f app",
    "nc:clean": "docker compose -f docker/compose.yml down -v",
    "nc-b:up": "docker compose -f docker/compose-b.yml up -d",
    "nc-b:provision": "COMPOSE_FILE=compose-b.yml BASE=http://localhost:8081 SANS_LOCK=1 bash docker/provisionner.sh",
    "nc-b:down": "docker compose -f docker/compose-b.yml down",
    "nc-b:clean": "docker compose -f docker/compose-b.yml down -v"
  },
  "keywords": [],
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "happy-dom": "^20.10.6",
    "typescript": "^6.0.3",
    "vite": "^7.3.5",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.3.4"
  },
  "dependencies": {
    "@tiptap/core": "^3.26.0",
    "@tiptap/pm": "^3.26.0",
    "@tiptap/starter-kit": "^3.26.0",
    "@tiptap/vue-3": "^3.26.0",
    "chardet": "^2.2.0",
    "docx": "^9.7.1",
    "iconv-lite": "^0.6.3",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.3.289",
    "vue": "^3.5.35"
  },
  "build": {
    "appId": "com.sonal.v2",
    "productName": "Sonal V2",
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**"
    ],
    "fileAssociations": [{
      "ext": "crp",
      "name": "Corpus Sonal",
      "description": "Corpus SonalPi2 (dossier multifichier)",
      "mimeType": "application/x-sonalpi-corpus",
      "role": "Editor",
      "rank": "Alternate"
    }],
    "asarUnpack": [
      "**/pdf.worker*.mjs"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "extraResources": [
      {
        "from": "docs/user",
        "to": "documentation",
        "filter": [
          "**/*.html",
          "**/*.css",
          "medias/*.png"
        ]
      },
      {
        "from": "ressources/docsCadreExemples",
        "to": "docsCadreExemples"
      },
      {
        "from": "CorpusTest",
        "to": "CorpusTest"
      }
    ]
  }
}
